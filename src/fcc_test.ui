       </item>
      </layout>
     </widget>
     <!-- Page 1: Arm -->
     <widget class="QWidget" name="pageArm">
      <layout class="QVBoxLayout" name="armLayout">
       <item>
        <widget class="QLabel" name="armIntro">
         <property name="text">
          <string>Instrument settings per FCC near-field doc: Ultra mode (serial: ultra on; PIN 4321 is for on-device unlock only), span 15 MHz–1 GHz, RBW 30 kHz, Max Hold. Buffer is cleared (calc off) before each arm so runs do not mix. Stop the main Run/Stop sweep before Arming.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="armSettingsPreview">
         <property name="text">
          <string>ultra on | calc off | sweep 15e6–1e9 | rbw 30 | attenuate 0 | lna off | spur auto | calc maxh</string>
         </property>
         <property name="styleSheet">
          <string>font-family: monospace; background: #222; color: #0f0; padding: 8px;</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QFormLayout" name="armForm">
         <item row="0" column="0">
          <widget class="QLabel" name="lblProbePath">
           <property name="text">
            <string>Probe / conversion</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QComboBox" name="probePath">
           <item>
            <property name="text">
             <string>TekBox E5 (−40 dB amp)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Schwarzbeck AF 20</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Schwarzbeck AF 47</string>
            </property>
           </item>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="lblAmpGain">
           <property name="text">
            <string>Amp gain (dB)</string>
           </property>
          </widget>
         </item>
         <item row="1" column="1">
          <widget class="QDoubleSpinBox" name="ampGainDb">
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="minimum">
            <double>0.0</double>
           </property>
           <property name="maximum">
            <double>60.0</double>
           </property>
           <property name="value">
            <double>40.0</double>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="lblCarrier">
           <property name="text">
            <string>Carrier (MHz) for harmonic marks</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="carrierMhz">
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="minimum">
            <double>1.0</double>
           </property>
           <property name="maximum">
            <double>100.0</double>
           </property>
           <property name="value">
            <double>20.0</double>
           </property>
          </widget>
         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="lblHold">
           <property name="text">
            <string>Hold time (minutes)</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="holdMinutes">
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>15</number>
           </property>
           <property name="value">
            <number>3</number>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="armBtnRow">
         <item>
          <widget class="QPushButton" name="btnMeasureSweep">
