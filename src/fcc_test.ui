          <string>DUT and battery are charged / connected</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkTinyCharged">
         <property name="text">
          <string>TinySA has enough charge</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkPlacement">
         <property name="text">
          <string>Device and probe placement / wire orientation fixed (tape recommended)</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QFormLayout" name="metaForm">
         <item row="0" column="0">
          <widget class="QLabel" name="lblRunLabel">
           <property name="text">
            <string>Run label</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QLineEdit" name="runLabel">
