     <!-- Page 2: Unplug -->
     <widget class="QWidget" name="pageUnplug">
      <layout class="QVBoxLayout" name="unplugLayout">
       <item>
        <widget class="QLabel" name="unplugIntro">
         <property name="text">
          <string>Disconnect the TinySA USB cable from the laptop now.
Leave the TinySA powered on and sweeping in Max Hold.
Do not touch the DUT / probe setup.</string>
