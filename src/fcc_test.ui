     <property name="text">
      <string>Step 1 of 7 — Checklist</string>
     </property>
     <property name="styleSheet">
      <string>font-size: 14pt; font-weight: bold;</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QStackedWidget" name="wizardStack">
     <!-- Page 0: Checklist -->
     <widget class="QWidget" name="pageChecklist">
      <layout class="QVBoxLayout" name="checklistLayout">
       <item>
        <widget class="QLabel" name="checklistIntro">
         <property name="text">
          <string>Confirm the setup before starting. Take a photo of the IDC setup for repeatability.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkPhoto">
