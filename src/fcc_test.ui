            <string>Ambient / Glass_BareBoard / Glass_TxWire_10cm</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0">
          <widget class="QLabel" name="lblDut">
           <property name="text">
            <string>DUT name</string>
           </property>
          </widget>
         </item>
