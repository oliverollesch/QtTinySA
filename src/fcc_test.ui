          <widget class="QLabel" name="lblDistance">
           <property name="text">
            <string>Probe distance (cm)</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="distanceCm">
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="minimum">
            <double>0.5</double>
           </property>
           <property name="maximum">
            <double>30.0</double>
           </property>
           <property name="value">
            <double>2.0</double>
