                 <widget class="QPushButton" name="btnUpdateOffset">
                  <property name="text">
                   <string>Update offset</string>
                  </property>
                  <property name="enabled">
                   <bool>false</bool>
                  </property>
                  <property name="toolTip">
                   <string>After fine jogging onto the selected point, shift the whole alignment by the error you just corrected.</string>
                  </property>
                 </widget>
