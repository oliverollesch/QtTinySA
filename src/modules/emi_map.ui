         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>10</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <!-- Page 2: Scan -->
     <widget class="QWidget" name="pageScan">
      <layout class="QVBoxLayout" name="scanLayout">
       <item>
        <layout class="QHBoxLayout" name="scanControls">
         <item>
          <widget class="QPushButton" name="btnStartScan">
           <property name="text">
            <string>Start scan</string>
           </property>
