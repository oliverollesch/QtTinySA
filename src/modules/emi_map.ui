       <item>
        <layout class="QHBoxLayout" name="resultsButtons">
         <item>
          <widget class="QPushButton" name="btnOpenFolder">
           <property name="text">
            <string>Open scan folder</string>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="resultsSpacer">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>40</width>
