     <property name="text">
      <string>Step 1 of 4 — Setup</string>
     </property>
     <property name="styleSheet">
      <string>font-size: 14pt; font-weight: bold;</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QStackedWidget" name="wizardStack">
     <!-- Page 0: Setup -->
     <widget class="QWidget" name="pageSetup">
      <layout class="QVBoxLayout" name="setupLayout">
       <item>
        <widget class="QLabel" name="setupIntro">
         <property name="text">
          <string>Mount the H-field probe on the X carriage and put the DUT on a non-conductive spacer. The scan moves X and Y only: probe height is set by hand and Z is never commanded.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpPrinter">
         <property name="title">
          <string>Printer</string>
