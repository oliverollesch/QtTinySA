              </item>
             </layout>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="targetRow">
             <item>
              <widget class="QCheckBox" name="chkSnapLandmark">
               <property name="text">
                <string>Snap to landmarks</string>
               </property>
               <property name="checked">
                <bool>true</bool>
               </property>
               <property name="toolTip">
