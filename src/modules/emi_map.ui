           <widget class="QLabel" name="lblMetric">
            <property name="text">
             <string>Metric</string>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <!-- Not named "metric": QWidget.metric() would shadow the child widget -->
           <widget class="QComboBox" name="metricBox">
            <item>
             <property name="text">
