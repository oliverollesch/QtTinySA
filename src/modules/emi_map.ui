          <string>Probe height and PCB travel are clear</string>
         </property>
         <property name="toolTip">
          <string>Required before a PCB-aligned scan. The probe will traverse the whole board; Z is never commanded.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="scanControls">
         <item>
          <widget class="QPushButton" name="btnStartScan">
           <property name="text">
            <string>Start scan</string>
           </property>
           <property name="toolTip">
            <string>Start the scan</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnContinueDut">
           <property name="text">
