   <item>
    <widget class="QStackedWidget" name="wizardStack">
     <!-- Page 0: Setup -->
     <widget class="QWidget" name="pageSetup">
      <layout class="QVBoxLayout" name="setupPageLayout">
       <property name="leftMargin">
