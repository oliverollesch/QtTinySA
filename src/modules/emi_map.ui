           <item>
            <widget class="QGroupBox" name="grpProfile">
             <property name="title">
              <string>Saved profile</string>
             </property>
             <layout class="QVBoxLayout" name="profileLayout">
              <property name="spacing">
               <number>4</number>
              </property>
              <item>
               <widget class="QLabel" name="profileIntro">
                <property name="text">
