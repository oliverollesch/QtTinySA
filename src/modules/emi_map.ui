                </property>
                <property name="wordWrap">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="identityForm">
                <item>
                 <widget class="QLineEdit" name="fixtureId">
                  <property name="placeholderText">
                   <string>Fixture</string>
                  </property>
                  <property name="toolTip">
                   <string>Fixture identifier, e.g. Ender bed fixture A</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QLineEdit" name="machineId">
                  <property name="placeholderText">
                   <string>Machine</string>
                  </property>
                  <property name="toolTip">
                   <string>Machine identifier, e.g. ender3-01</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QLineEdit" name="probeSetupId">
                  <property name="placeholderText">
                   <string>Probe</string>
                  </property>
                  <property name="toolTip">
                   <string>Probe setup identifier, e.g. loop-6mm-holder-v2</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <widget class="QCheckBox" name="chkBoardSeated">
                <property name="text">
                 <string>Board seated as saved</string>
                </property>
                <property name="toolTip">
                 <string>Board is seated in the same position and orientation as when the profile was saved</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QCheckBox" name="chkOrientationLocked">
                <property name="text">
                 <string>Fixture holds orientation</string>
                </property>
                <property name="toolTip">
                 <string>PCB orientation is mechanically constrained by a fixture or hard stop. Allows one verification point instead of two. One point pins translation but cannot detect rotation about that point.</string>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="profileRow">
                <item>
                 <widget class="QComboBox" name="fixtureProfile"/>
                </item>
                <item>
                 <widget class="QPushButton" name="btnLoadProfile">
                  <property name="text">
                   <string>Load</string>
                  </property>
                  <property name="enabled">
                   <bool>false</bool>
                  </property>
