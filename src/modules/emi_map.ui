          <enum>QFrame::NoFrame</enum>
         </property>
         <property name="horizontalScrollBarPolicy">
          <enum>Qt::ScrollBarAlwaysOff</enum>
         </property>
         <widget class="QWidget" name="setupInner">
          <layout class="QVBoxLayout" name="setupLayout">
       <item>
        <widget class="QLabel" name="setupIntro">
         <property name="text">
          <string>Mount the H-field probe on the X carriage and put the DUT on a non-conductive spacer. The scan moves X and Y only: probe height is set by hand and Z is never commanded.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="modeLayout">
         <item>
          <widget class="QLabel" name="lblScanMode">
           <property name="text">
            <string>Scan mode</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="scanMode">
           <item>
            <property name="text">
             <string>PCB aligned</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Rectangle</string>
            </property>
           </item>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="modeHint">
           <property name="text">
            <string>PCB aligned: import the board, home X/Y, click two landmarks, then scan. Rectangle: mark a corner as X0 Y0 and scan a box. Next tells you which path you are on.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
