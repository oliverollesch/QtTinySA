             </item>
             <item>
              <widget class="QPushButton" name="btnMoveHere">
               <property name="text">
                <string>Move here</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="toolTip">
                <string>Drive the probe to the selected point using the current alignment. Clicking the plot only selects; nothing moves until this is pressed.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnConfirmAlignment">
               <property name="text">
                <string>Confirm</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="toolTip">
                <string>Confirm that the probe is standing on the selected feature. Required after loading a profile, before a scan. Only available immediately after Move here, and invalidated by any jog.</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="targetLabel">
             <property name="text">
              <string>No point selected.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="landmarkButtons">
             <item>
              <widget class="QPushButton" name="btnRecordLandmark">
               <property name="text">
                <string>Record</string>
               </property>
               <property name="toolTip">
                <string>Record the selected board point at the probe's current machine position.</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnRemoveLandmark">
               <property name="text">
                <string>Remove</string>
               </property>
               <property name="toolTip">
                <string>Drop the highlighted landmark, keeping the rest. Use the Error column to find the one that is on the wrong feature.</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="btnClearLandmarks">
               <property name="text">
                <string>Clear</string>
               </property>
               <property name="toolTip">
                <string>Clear every recorded landmark and the current alignment.</string>
               </property>
              </widget>
             </item>
            </layout>
