            </property>
            <property name="value">
             <double>0.0</double>
            </property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="lblAtten">
            <property name="text">
             <string>Attenuation (dB, -1 = auto)</string>
            </property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QSpinBox" name="attenDb">
            <property name="minimum">
             <number>-1</number>
