      </layout>
     </widget>
     <!-- Page 3: Origin (Rectangle mode only) -->
     <widget class="QWidget" name="pageOrigin">
      <layout class="QVBoxLayout" name="originLayout">
       <item>
        <widget class="QLabel" name="originIntro">
         <property name="text">
          <string>This page is Rectangle mode only. It names the current probe position X0 Y0; the scan then moves +X and +Y from here. It does not import a PCB.

To scan a board: Back, set Scan mode to PCB aligned, then Next. That path is Setup → import ODB++ → home X/Y and register two landmarks → Scan.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="travelWarning">
         <property name="text">
          <string>The probe will move.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="styleSheet">
          <string>font-size: 12pt; font-weight: bold; color: #b30000; border: 2px solid #b30000; padding: 10px;</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkTravelClear">
         <property name="text">
          <string>I have verified the full travel area is clear</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnSetOrigin">
         <property name="text">
          <string>Set origin here (G92 X0 Y0)</string>
         </property>
         <property name="enabled">
          <bool>false</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="originStatus">
         <property name="text">
          <string>Origin not set.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="originSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>10</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <!-- Page 4: Scan -->
     <widget class="QWidget" name="pageScan">
      <layout class="QVBoxLayout" name="scanLayout">
       <item>
        <widget class="QLabel" name="scanIntro">
         <property name="text">
          <string>Confirm the probe height and PCB travel are clear, then Start scan.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chkTravelClearBoard">
